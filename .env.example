LLM_PROVIDER=ollama
DATABASE_PATH=data/doubtgpt.sqlite3
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SAMPLE_COUNT=3
